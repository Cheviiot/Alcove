<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<component type="desktop-application">
  <id>io.github.cheviiot.alcove</id>
  <name>Alcove</name>
  <summary>Create isolated web applications for GNOME</summary>
  <developer id="io.github.cheviiot">
    <name>Cheviiot and Alcove contributors</name>
    <url>https://github.com/Cheviiot</url>
  </developer>
  <icon type="stock">io.github.cheviiot.alcove</icon>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <content_rating type="oars-1.1" />
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#3A7D78</color>
    <color type="primary" scheme_preference="dark">#344955</color>
  </branding>
  <description>
    <p>
      Alcove is a GNOME-native manager for isolated web applications. WebKitGTK
      is the default engine, and Chromium is available as a Flatpak add-on for
      explicitly selected sites. Each website gets separate local data, cookies,
      cache, settings, and its own desktop launcher.
    </p>
    <p>
      Alcove is an independent successor to Spider. The original work by
      Zaedus, Cameron Radmore's contribution, and their Git history remain
      credited. Alcove is developed independently and does not claim their
      endorsement or participation.
    </p>
    <ul>
      <li>Create, edit, repair, and remove portal-installed launchers</li>
      <li>Fetch and safely normalize website icons with an offline fallback; an optional Icon Horse request is made only by explicit user action</li>
      <li>Keep each application's configuration, policy, profile, and cache separate</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/Cheviiot/Alcove</url>
  <url type="bugtracker">https://github.com/Cheviiot/Alcove/issues</url>
  <url type="vcs-browser">https://github.com/Cheviiot/Alcove</url>
  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>
  <launchable type="desktop-id">io.github.cheviiot.alcove.desktop</launchable>
  <releases>
    <release version="0.1.0" date="2026-09-20">
      <description>
        <ul>
          <li>Turn any valid HTTP(S) address into an isolated desktop application</li>
          <li>Keep each site's profile, cookies, cache and storage separate</li>
          <li>Use WebKitGTK by default and offer Chromium as an optional add-on</li>
          <li>Integrate with GNOME through desktop portals and encrypted backups</li>
        </ul>
      </description>
      <url>https://github.com/Cheviiot/Alcove/releases/tag/v0.1.0</url>
    </release>
  </releases>
</component>
