<component type="addon">
  <id>io.github.cheviiot.alcove.ChromiumNative</id>
  <extends>io.github.cheviiot.alcove</extends>
  <name>Chromium Engine for Alcove</name>
  <name xml:lang="ru">Движок Chromium для Alcove</name>
  <summary>Optional Chromium compatibility engine</summary>
  <summary xml:lang="ru">Дополнительный движок Chromium для совместимости</summary>
  <developer id="io.github.cheviiot">
    <name>Cheviiot and Alcove contributors</name>
    <url>https://github.com/Cheviiot</url>
  </developer>
  <icon type="stock">io.github.cheviiot.alcove</icon>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <content_rating type="oars-1.1" />
  <description>
    <p>
      Adds the Chromium engine to Alcove for websites that do not work well
      with the default WebKitGTK engine. Engine profiles remain isolated and
      Alcove never switches engines without confirmation.
    </p>
    <p xml:lang="ru">
      Добавляет в Alcove движок Chromium для сайтов, которые плохо работают с
      WebKitGTK. Профили движков остаются изолированными, а переключение всегда
      требует подтверждения пользователя.
    </p>
  </description>
  <url type="homepage">https://github.com/Cheviiot/Alcove</url>
  <url type="bugtracker">https://github.com/Cheviiot/Alcove/issues</url>
  <releases>
    <release version="0.1.0" date="2026-09-20" />
  </releases>
</component>
