{
  "id": "io.github.cheviiot.alcove",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "alcove",
  "separate-locales": false,
  "add-extensions": {
    "io.github.cheviiot.alcove.Chromium": {
      "version": "master",
      "directory": "extensions/chromium",
      "bundle": true,
      "no-autodownload": true,
      "autodelete": true
    }
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--own-name=io.github.cheviiot.alcove.Chromium",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "alcove=debug"
    }
  },
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.18.0",
          "commit": "07c9c9df9cd1b6b4454ecba21ee58211e9144a4b"
        }
      ]
    },
    {
      "name": "alcove-chromium-broker",
      "buildsystem": "simple",
      "build-commands": [
        "cc -std=c17 -O2 -Wall -Wextra -Werror src/broker.c -o alcove-chromium-service $(pkg-config --cflags --libs gio-2.0 json-glib-1.0)",
        "./alcove-chromium-service --self-test",
        "install -Dm755 alcove-chromium-service /app/bin/alcove-chromium-service",
        "install -d /app/extensions/chromium /app/share/dbus-1/services",
        "install -Dm644 data/io.github.cheviiot.alcove.Chromium.service /app/share/dbus-1/services/io.github.cheviiot.alcove.Chromium.service"
      ],
      "sources": [{ "type": "dir", "path": "../chromium" }]
    },
    {
      "name": "zypak",
      "buildsystem": "simple",
      "build-commands": [
        "./configure",
        "make -j${FLATPAK_BUILDER_N_JOBS}",
        "make FLATPAK_DEST=/app/extensions/chromium install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/refi64/zypak",
          "tag": "v2025.09",
          "commit": "693a71c5ffa80ec9c9ce2ae03b1ccc493c698e53"
        }
      ]
    },
    {
      "name": "alcove-chromium-addon",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a electron/. /app/extensions/chromium/",
        "install -Dm644 src/main.js src/validate.js src/navigation-policy.js src/permission-policy.js src/proxy.js src/user-agent.js src/window-state.js src/shell-security.js src/shell-preload.js src/shell.html src/shell.css src/shell.js /app/extensions/chromium/",
        "install -Dm644 data/io.github.cheviiot.alcove.Chromium.metainfo.xml -t /app/extensions/chromium/share/metainfo",
        "install -d /app/extensions/chromium/share/licenses",
        "mv /app/share/licenses/io.github.cheviiot.alcove/zypak /app/extensions/chromium/share/licenses/",
        "rmdir --ignore-fail-on-non-empty /app/share/licenses/io.github.cheviiot.alcove /app/share/licenses"
      ],
      "sources": [
        { "type": "dir", "path": "../chromium" },
        {
          "type": "archive",
          "url": "https://github.com/electron/electron/releases/download/v40.1.0/electron-v40.1.0-linux-x64.zip",
          "sha256": "26f7675cc103f6ca0a1122d82f30bed7544c1a5d5507a6980992ae07ec876a12",
          "dest": "electron",
          "strip-components": 0,
          "only-arches": ["x86_64"]
        },
        {
          "type": "archive",
          "url": "https://github.com/electron/electron/releases/download/v40.1.0/electron-v40.1.0-linux-arm64.zip",
          "sha256": "4f07ff00445a707289d46f52dffd6faa504a4b60355ddb20df36ff8daa5cfc70",
          "dest": "electron",
          "strip-components": 0,
          "only-arches": ["aarch64"]
        }
      ]
    },
    {
      "name": "alcove",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["-Dflatpak=true"],
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/alcove/cargo"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-build",
            ".flatpak-builder",
            ".flatpak-build-v03",
            ".flatpak-builder-v03",
            ".flatpak-repo",
            ".local-release",
            "Alcove-x86_64.flatpak",
            "build",
            "target"
          ]
        },
        "generated-sources.json"
      ]
    }
  ]
}
