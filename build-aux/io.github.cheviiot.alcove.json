{
  "id": "io.github.cheviiot.alcove",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "alcove",
  "separate-locales": false,
  "add-extensions": {
    "io.github.cheviiot.alcove.ChromiumNative": {
      "version": "master",
      "directory": "extensions/chromium-native",
      "bundle": true,
      "no-autodownload": true,
      "autodelete": true
    }
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--env=GTK_USE_PORTAL=1",
    "--env=ALCOVE_NATIVE_CHROMIUM_ADDON=/app/extensions/chromium-native/addon.json"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "alcove=debug"
    }
  },
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.18.0",
          "commit": "07c9c9df9cd1b6b4454ecba21ee58211e9144a4b"
        }
      ]
    },
    {
      "name": "zypak",
      "buildsystem": "simple",
      "build-commands": [
        "./configure",
        "make -j${FLATPAK_BUILDER_N_JOBS}",
        "make FLATPAK_DEST=/app/extensions/chromium-native install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/refi64/zypak",
          "tag": "v2025.09",
          "commit": "693a71c5ffa80ec9c9ce2ae03b1ccc493c698e53",
          "disable-submodules": true
        },
        {
          "type": "git",
          "url": "https://github.com/refi64/nickle",
          "commit": "0ac7f5dbf659caa8d1d45cb57e942f2bc565da1e",
          "disable-submodules": true,
          "dest": "nickle"
        }
      ],
      "only-arches": [
        "x86_64"
      ]
    },
    {
      "name": "nlohmann-json",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DJSON_BuildTests=OFF",
        "-DJSON_Install=ON"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/nlohmann/json/releases/download/v3.12.0/json.tar.xz",
          "sha256": "42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa"
        }
      ],
      "only-arches": [
        "x86_64"
      ]
    },
    {
      "name": "alcove-native-chromium",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _build -G Ninja -DCEF_ROOT=\"$PWD/cef\" -DCMAKE_BUILD_TYPE=Release",
        "cmake --build _build --parallel ${FLATPAK_BUILDER_N_JOBS}",
        "install -Dm755 _build/alcove-cef-worker /app/extensions/chromium-native/worker/alcove-cef-worker",
        "install -d /app/extensions/chromium-native/cef",
        "cp -a cef/Release cef/Resources /app/extensions/chromium-native/cef/",
        "for library in /app/extensions/chromium-native/cef/Release/*.so*; do ln -s ../cef/Release/\"$(basename \"$library\")\" /app/extensions/chromium-native/worker/; done",
        "ln -s ../cef/Release/v8_context_snapshot.bin /app/extensions/chromium-native/worker/",
        "ln -s ../cef/Release/chrome-sandbox /app/extensions/chromium-native/worker/",
        "ln -s ../cef/Resources/icudtl.dat ../cef/Resources/locales /app/extensions/chromium-native/worker/",
        "for resource in /app/extensions/chromium-native/cef/Resources/*.pak; do ln -s ../cef/Resources/\"$(basename \"$resource\")\" /app/extensions/chromium-native/worker/; done",
        "install -Dm755 flatpak-worker.sh /app/extensions/chromium-native/bin/alcove-cef-launch",
        "install -Dm644 addon.json /app/extensions/chromium-native/addon.json",
        "install -Dm644 cef/LICENSE.txt /app/extensions/chromium-native/share/licenses/cef/LICENSE.txt",
        "install -Dm644 io.github.cheviiot.alcove.ChromiumNative.metainfo.xml /app/extensions/chromium-native/share/metainfo/io.github.cheviiot.alcove.ChromiumNative.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../experiments/native-chromium/CMakeLists.txt"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/worker.cc"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/atspi_export.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/gpu_bridge.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/native_accessibility.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/navigation_gate.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/permission_settings.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/site_requests.h"
        },
        {
          "type": "file",
          "path": "../experiments/native-chromium/flatpak-worker.sh"
        },
        {
          "type": "file",
          "path": "../data/io.github.cheviiot.alcove.ChromiumNative.metainfo.xml"
        },
        {
          "type": "archive",
          "url": "https://cef-builds.spotifycdn.com/cef_binary_152.0.7+g83ffcba+chromium-152.0.7977.83_linux64_minimal.tar.bz2",
          "sha256": "a75d8956901e1f91bad4f7151af1dc31aaa2d46888cd6af51adb0ecaa77f860f",
          "dest": "cef"
        },
        {
          "type": "inline",
          "dest-filename": "addon.json",
          "contents": "{\"schema_version\": 1, \"worker_protocol\": 4, \"cef_version\": \"152.0.7+g83ffcba+chromium-152.0.7977.83\", \"worker\": \"bin/alcove-cef-launch\", \"cef_root\": \"cef\"}"
        }
      ],
      "only-arches": [
        "x86_64"
      ]
    },
    {
      "name": "alcove",
      "builddir": true,
      "buildsystem": "meson",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/alcove/cargo"
        }
      },
      "config-opts": [
        "-Dflatpak=true"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Cheviiot/Alcove.git",
          "commit": "v0.1.0"
        },
        "generated-sources.json"
      ]
    }
  ]
}
